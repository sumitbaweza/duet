# Copy to /etc/duet.env on the server (sudo cp deploy/duet.env.example /etc/duet.env)
# and replace the secret with the same value you put in /etc/turnserver.conf.

TURN_URLS=turn:duetwatch.com:3478?transport=udp,turn:duetwatch.com:3478?transport=tcp
TURN_SECRET=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_AS_COTURN
